{
  "expo": {
    "name": "startapp",
    "slug": "startapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "startapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.startapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.startapp"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "870f11a5-d870-4d20-8d85-57f2a226f653"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O CleanSynk usa suas fotos para você colocar a foto da lavanderia."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O CleanSynk usa sua localização para mostrar a sua cidade."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "",
          "enableGooglePay": false
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "imageWidth": 200
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
